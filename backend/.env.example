# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (DATABASE_URL takes precedence if set; otherwise POSTGRES_* are used)
DATABASE_URL=postgres://event_user:event_pass@db:5432/event_analytics
POSTGRES_DB=event_analytics
POSTGRES_USER=event_user
POSTGRES_PASSWORD=event_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting / proxying
RATE_LIMIT_PER_MINUTE=30
NUM_PROXIES=1

# Validation
MAX_PAYLOAD_BYTES=16384

# Logging
LOG_LEVEL=INFO
